# ============================================================
# SIAKAR — .gitignore
# ============================================================

# --- Dataset & foto (JANGAN pernah di-commit) ---
ml/data/
ml/.venv/
ml/**/__pycache__/
ml/**/*.pyc
*.egg-info/

# --- Model besar (artefak TFLite disalin secara eksplisit) ---
ml/artifacts/*.tflite
ml/artifacts/*.h5
ml/artifacts/*.keras
ml/artifacts/checkpoints/

# --- Lingkungan Python ---
.venv/
venv/
env/
*.pyo
*.pyd

# --- Rahasia ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Laravel ---
admin/vendor/
admin/node_modules/
admin/public/hot
admin/public/storage
admin/storage/*.key
admin/bootstrap/cache/
admin/.env
admin/.env.*
!admin/.env.example

# --- Flutter ---
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/google-services.json
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Pods/

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE ---
.idea/
.vscode/settings.json
*.iml
.DS_Store
Thumbs.db

# --- Log & cache ---
*.log
.cache/

# --- Foto & data pribadi ---
*.jpg
*.jpeg
*.png
# Kecuali aset UI
!mobile/assets/**/*.png
!mobile/assets/**/*.jpg
!admin/public/img/**
!docs/**/*.png

# --- Storage privat Laravel ---
admin/storage/app/private/
